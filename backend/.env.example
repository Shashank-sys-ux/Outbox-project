NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_URL=https://localhost:5173
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgresql://outbox:outbox_dev_password@localhost:5432/outbox
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=outbox-emails

SESSION_SECRET=replace-with-output-of-node-e-console.log(require('crypto').randomBytes(48).toString('base64url'))
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=true
ENCRYPTION_KEY=replace-with-output-of-node-e-console.log(require('crypto').randomBytes(32).toString('base64'))

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:5173/api/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://localhost:5173/api/slack/callback

ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

ADMIN_EMAILS=
BULL_BOARD_READ_ONLY=false

WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_WINDOW_MS=3600000
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BACKOFF_MS=30000
EMAIL_LOCK_DURATION_MS=30000
SMTP_TIMEOUT_MS=20000

UPLOAD_MAX_BYTES=5242880
MAX_RECIPIENTS_PER_CAMPAIGN=10000
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=30
