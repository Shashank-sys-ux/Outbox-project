{
  "name": "outbox-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "dev:worker": "tsx watch --include .env src/worker.ts",
    "auth:check-google": "tsx scripts/check-google-oauth.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "search:reindex": "tsx scripts/search-reindex.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@bull-board/api": "9.10.1",
    "@bull-board/express": "9.10.1",
    "@elastic/elasticsearch": "9.5.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.9",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.4.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
