    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.5.1",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
